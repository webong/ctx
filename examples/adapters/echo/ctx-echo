#!/usr/bin/env sh
set -eu

operation="${1:-}"
case "$operation" in
  list)
    printf 'local\nstaging\n'
    ;;
  validate)
    case "${2:-}" in local|staging) ;; *) printf 'echo: unknown selection %s\n' "${2:-}" >&2; exit 1 ;; esac
    ;;
  doctor)
    selection="${2:-}"
    case "$selection" in ''|local|staging) ;; *) printf 'echo: unknown selection %s\n' "$selection" >&2; exit 1 ;; esac
    ;;
  run|open)
    selection="${2:-}"
    shift 2
    [ "${1:-}" = -- ] && shift
    case "$selection" in local|staging) ;; *) printf 'echo: unknown selection %s\n' "$selection" >&2; exit 1 ;; esac
    printf '%s[%s]' "$operation" "$selection"
    for argument in "$@"; do printf ' %s' "$argument"; done
    printf '\n'
    ;;
  *)
    printf 'echo: unsupported operation %s\n' "$operation" >&2
    exit 2
    ;;
esac
