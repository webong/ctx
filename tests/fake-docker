#!/usr/bin/env sh
set -eu

if [ "${1:-}" = context ] && [ "${2:-}" = inspect ]; then
  case "${3:-}" in alpha|beta|default) exit 0;; esac
  exit 1
fi

if [ "${1:-}" = context ] && [ "${2:-}" = ls ]; then
  if [ "${4:-}" = '{{json .Name}}' ]; then
    printf '"default"\n"alpha"\n"beta"\n'
  else
    printf 'default\nalpha\nbeta\n'
  fi
  exit 0
fi

if [ "${1:-}" = --context ] && [ "${3:-}" = info ]; then exit 1; fi
if [ "${1:-}" = --context ] && [ "${3:-}" = print-env ]; then printf '%s\n' "${APP_ENV:-}"; exit 0; fi

if [ "${1:-}" = --context ] && [ "${3:-}" = volume ] && [ "${4:-}" = inspect ]; then
  [ "${5:-}" = exists ] && exit 0
  exit 1
fi
printf '%s\n' "$*"
