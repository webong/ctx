#!/usr/bin/env sh
set -eu
gcloud=$(command -v gcloud 2>/dev/null || true)
[ -n "$gcloud" ] || { printf 'gcloud: Google Cloud CLI is not installed\n' >&2; exit 127; }
operation=${1:-}
selection=${2:-}
configuration_exists() { "$gcloud" config configurations list --filter="name=$1" --format='value(name)' | grep -Fxq "$1"; }
case "$operation" in
  list) "$gcloud" config configurations list ;;
  validate) configuration_exists "$selection" || { printf 'gcloud: unknown configuration %s\n' "$selection" >&2; exit 1; } ;;
  doctor) [ -z "$selection" ] || configuration_exists "$selection" || { printf 'gcloud: unknown configuration %s\n' "$selection" >&2; exit 1; } ;;
  run)
    shift 2; [ "${1:-}" = -- ] && shift
    if [ -n "${CLOUDSDK_ACTIVE_CONFIG_NAME:-}" ]; then "$gcloud" "$@"; exit; fi
    for arg in "$@"; do case "$arg" in --configuration|--configuration=*) "$gcloud" "$@"; exit;; esac; done
    "$gcloud" --configuration "$selection" "$@"
    ;;
  *) exit 2 ;;
esac
