#!/usr/bin/env sh
set -eu
aws=$(command -v aws 2>/dev/null || true)
[ -n "$aws" ] || { printf 'aws: AWS CLI is not installed\n' >&2; exit 127; }
operation=${1:-}
selection=${2:-}
profile_exists() { "$aws" configure list-profiles | grep -Fxq "$1"; }
case "$operation" in
  list) "$aws" configure list-profiles ;;
  validate) profile_exists "$selection" || { printf 'aws: unknown profile %s\n' "$selection" >&2; exit 1; } ;;
  doctor) [ -z "$selection" ] || profile_exists "$selection" || { printf 'aws: unknown profile %s\n' "$selection" >&2; exit 1; } ;;
  run)
    shift 2; [ "${1:-}" = -- ] && shift
    if [ -n "${AWS_PROFILE:-}" ] || [ -n "${AWS_DEFAULT_PROFILE:-}" ]; then "$aws" "$@"; exit; fi
    for arg in "$@"; do case "$arg" in --profile|--profile=*) "$aws" "$@"; exit;; esac; done
    "$aws" --profile "$selection" "$@"
    ;;
  *) exit 2 ;;
esac
