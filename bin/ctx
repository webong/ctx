#!/usr/bin/env sh
# ctx command — project-local Docker contexts and Podman connections
set -eu

CTX_HOME=${CTX_HOME:-$HOME/.config/ctx}
CONFIG="$CTX_HOME/config.toml"
VERSION=0.5.0
VOLUME_IMAGE=${CTX_VOLUME_IMAGE:-alpine:3.21}

usage() {
  cat <<'HELP'
ctx — project-local container connections
usage:
  ctx status [docker|podman|nerdctl]
  ctx ls <docker|podman|nerdctl>
  ctx set <docker|podman|nerdctl> <name> [--global]
  ctx clear [docker|podman|nerdctl]
  ctx build [docker|podman|nerdctl] --cache-ref <registry-ref> [--] <build arguments>
  ctx image sync [--tar] <source-context> <target-context> <image>...
  ctx image copy <engine:endpoint> <engine:endpoint> <image>...
  ctx volume export <source-context> <volume> > volume.tar
  ctx volume import <target-context> <new-volume> < volume.tar
  ctx volume copy <engine:endpoint> <engine:endpoint> <source-volume> [target-volume]
  ctx version

Project choices are stored in .ctx. --global writes a fallback to config.toml.
HELP
}

check_tool() {
  case "$1" in docker|podman|nerdctl) ;; *) printf 'ctx: use docker, podman, or nerdctl\n' >&2; exit 2;; esac
}

find_real() {
  tool="$1"
  remaining="$PATH:"
  while [ -n "$remaining" ]; do
    part=${remaining%%:*}
    remaining=${remaining#*:}
    [ -n "$part" ] || part=.
    candidate="$part/$tool"
    if [ -x "$candidate" ] && ! (dd if="$candidate" bs=256 count=1 2>/dev/null | grep -Eq 'ctx wrapper|dctx shim'); then
      printf '%s\n' "$candidate"
      return 0
    fi
  done
  printf 'ctx: %s CLI not found on PATH\n' "$tool" >&2
  return 127
}

read_choice() {
  file="$1"
  key="$2"
  [ -f "$file" ] || return 0
  awk -v key="$key" '
    $0 ~ "^[[:space:]]*" key "[[:space:]]*=[[:space:]]*\"" {
      line=$0
      sub(/^[[:space:]]*[a-z]+[[:space:]]*=[[:space:]]*"/, "", line)
      sub(/".*$/, "", line)
      if (line != "") { print line; exit }
    }
  ' "$file"
}

read_project_map() {
  dir="$1"
  tool="$2"
  [ -f "$CONFIG" ] || return 0
  awk -v section="[projects.\"$dir\"]" -v key="$tool" '
    /^\[/ { active=($0 == section); next }
    active && $0 ~ "^[[:space:]]*" key "[[:space:]]*=[[:space:]]*\"" {
      line=$0
      sub(/^[[:space:]]*[a-z]+[[:space:]]*=[[:space:]]*"/, "", line)
      sub(/".*$/, "", line)
      if (line != "") { print line; exit }
    }
  ' "$CONFIG"
}

read_default() {
  tool="$1"
  [ -f "$CONFIG" ] || return 0
  awk -v key="${tool}_default" '
    /^\[/ { exit }
    $0 ~ "^[[:space:]]*" key "[[:space:]]*=[[:space:]]*\"" {
      line=$0
      sub(/^[[:space:]]*[a-z_]+[[:space:]]*=[[:space:]]*"/, "", line)
      sub(/".*$/, "", line)
      if (line != "") { print line; exit }
    }
  ' "$CONFIG"
}

probe_docker() {
  real=$(find_real docker 2>/dev/null || true)
  [ -n "$real" ] || return 0
  orb=0
  desktop=0
  if [ -S "$HOME/.orbstack/run/docker.sock" ] && "$real" --context orbstack info >/dev/null 2>&1; then orb=1; fi
  if [ -S "$HOME/.docker/run/docker.sock" ] && "$real" --context desktop-linux info >/dev/null 2>&1; then desktop=1; fi
  if [ "$orb" = 1 ] && [ "$desktop" = 0 ]; then
    RESOLVED=orbstack; VIA='OrbStack daemon'
  elif [ "$desktop" = 1 ] && [ "$orb" = 0 ]; then
    RESOLVED=desktop-linux; VIA='Docker Desktop daemon'
  elif [ "$orb" = 1 ] && [ "$desktop" = 1 ]; then
    orb_time=$(stat -f %m "$HOME/.orbstack/run/docker.sock" 2>/dev/null || stat -c %Y "$HOME/.orbstack/run/docker.sock" 2>/dev/null || printf 0)
    desktop_time=$(stat -f %m "$HOME/.docker/run/docker.sock" 2>/dev/null || stat -c %Y "$HOME/.docker/run/docker.sock" 2>/dev/null || printf 0)
    if [ "$desktop_time" -gt "$orb_time" ]; then
      RESOLVED=desktop-linux; VIA='newer Docker Desktop socket'
    else
      RESOLVED=orbstack; VIA='newer OrbStack socket'
    fi
  fi
}

resolve() {
  tool="$1"
  RESOLVED=
  VIA=
  dir="$PWD"
  while :; do
    choice=$(read_choice "$dir/.ctx" "$tool")
    if [ -n "$choice" ]; then
      RESOLVED="$choice"; VIA="$dir/.ctx"; return
    fi
    choice=$(read_project_map "$dir" "$tool")
    if [ -n "$choice" ]; then
      RESOLVED="$choice"; VIA="$CONFIG project map"; return
    fi
    if [ "$dir" = "$HOME" ] || [ "$dir" = / ]; then break; fi
    dir=$(dirname "$dir")
  done
  if [ "$tool" = docker ]; then probe_docker; fi
  if [ -n "$RESOLVED" ]; then return; fi
  choice=$(read_default "$tool")
  if [ -n "$choice" ]; then
    RESOLVED="$choice"; VIA="$CONFIG default"
  else
    VIA="$tool default"
  fi
}

status_one() {
  tool="$1"
  case "$tool" in
    docker)
      if [ -n "${DOCKER_CONTEXT:-}" ]; then printf 'docker: %s (DOCKER_CONTEXT)\n' "$DOCKER_CONTEXT"; return; fi
      if [ -n "${DOCKER_HOST:-}" ]; then printf 'docker: %s (DOCKER_HOST)\n' "$DOCKER_HOST"; return; fi
      ;;
    podman)
      if [ -n "${CONTAINER_CONNECTION:-}" ]; then printf 'podman: %s (CONTAINER_CONNECTION)\n' "$CONTAINER_CONNECTION"; return; fi
      if [ -n "${CONTAINER_HOST:-}" ]; then printf 'podman: %s (CONTAINER_HOST)\n' "$CONTAINER_HOST"; return; fi
      ;;
    nerdctl)
      if [ -n "${CONTAINERD_NAMESPACE:-}" ]; then printf 'nerdctl: %s (CONTAINERD_NAMESPACE)\n' "$CONTAINERD_NAMESPACE"; return; fi
      ;;
  esac
  resolve "$tool"
  if [ -n "$RESOLVED" ]; then printf '%s: %s (%s)\n' "$tool" "$RESOLVED" "$VIA"
  else printf '%s: %s\n' "$tool" "$VIA"; fi
}

validate_choice() {
  tool="$1"
  name="$2"
  if [ "$tool" = apple ]; then real=$(find_real container)
  else real=$(find_real "$tool"); fi
  case "$tool" in
    docker) "$real" context inspect "$name" >/dev/null 2>&1 ;;
    podman) "$real" system connection list --format '{{.Name}}' | grep -Fxq "$name" ;;
    nerdctl) "$real" namespace ls --quiet | grep -Fxq "$name" ;;
    apple) [ "$name" = local ] && "$real" system version >/dev/null 2>&1 ;;
    *) return 1 ;;
  esac
}

docker_exec() {
  real=$(find_real docker)
  if [ -n "${DOCKER_CONTEXT:-}" ] || [ -n "${DOCKER_HOST:-}" ]; then
    "$real" "$@"
    return
  fi
  resolve docker
  if [ -n "$RESOLVED" ]; then
    "$real" --context "$RESOLVED" "$@"
  else
    "$real" "$@"
  fi
}

podman_exec() {
  real=$(find_real podman)
  if [ -n "${CONTAINER_CONNECTION:-}" ] || [ -n "${CONTAINER_HOST:-}" ]; then
    "$real" "$@"
    return
  fi
  resolve podman
  if [ -n "$RESOLVED" ]; then
    "$real" --connection "$RESOLVED" "$@"
  else
    "$real" "$@"
  fi
}

nerdctl_exec() {
  real=$(find_real nerdctl)
  if [ -n "${CONTAINERD_NAMESPACE:-}" ] || [ -n "${CONTAINERD_ADDRESS:-}" ]; then
    "$real" "$@"
    return
  fi
  resolve nerdctl
  if [ -n "$RESOLVED" ]; then
    "$real" --namespace "$RESOLVED" "$@"
  else
    "$real" "$@"
  fi
}

docker_context_exec() {
  context=$1
  shift
  if ! validate_choice docker "$context"; then
    printf 'ctx: unknown Docker context %s\n' "$context" >&2
    exit 1
  fi
  real=$(find_real docker)
  "$real" --context "$context" "$@"
}

parse_endpoint() {
  endpoint=$1
  case "$endpoint" in
    docker:*) ENDPOINT_TOOL=docker; ENDPOINT_NAME=${endpoint#docker:} ;;
    podman:*) ENDPOINT_TOOL=podman; ENDPOINT_NAME=${endpoint#podman:} ;;
    nerdctl:*) ENDPOINT_TOOL=nerdctl; ENDPOINT_NAME=${endpoint#nerdctl:} ;;
    apple:*) ENDPOINT_TOOL=apple; ENDPOINT_NAME=${endpoint#apple:} ;;
    *)
      printf 'ctx: endpoint must be docker:<context>, podman:<connection>, nerdctl:<namespace>, or apple:local\n' >&2
      exit 2
      ;;
  esac
  [ -n "$ENDPOINT_NAME" ] || {
    printf 'ctx: endpoint name cannot be empty\n' >&2
    exit 2
  }
}

endpoint_exec() {
  endpoint=$1
  shift
  parse_endpoint "$endpoint"
  if ! validate_choice "$ENDPOINT_TOOL" "$ENDPOINT_NAME"; then
    printf 'ctx: unknown %s endpoint %s\n' "$ENDPOINT_TOOL" "$ENDPOINT_NAME" >&2
    exit 1
  fi
  case "$ENDPOINT_TOOL" in
    docker)
      real=$(find_real docker)
      "$real" --context "$ENDPOINT_NAME" "$@"
      ;;
    podman)
      real=$(find_real podman)
      "$real" --connection "$ENDPOINT_NAME" "$@"
      ;;
    nerdctl)
      real=$(find_real nerdctl)
      "$real" --namespace "$ENDPOINT_NAME" "$@"
      ;;
    apple)
      real=$(find_real container)
      "$real" "$@"
      ;;
  esac
}

apple_image_load_is_safe() {
  real=$(find_real container)
  version=$("$real" --version 2>/dev/null | sed -n 's/.*version \([0-9][0-9]*\.[0-9][0-9]*\.[0-9][0-9]*\).*/\1/p' | head -n 1)
  [ -n "$version" ] || return 1
  awk -F. -v version="$version" 'BEGIN {
    split(version, part, ".")
    if (part[1] > 1 || (part[1] == 1 && (part[2] > 3 || (part[2] == 3 && part[3] > 0)))) exit 0
    exit 1
  }'
}

endpoint_image_save() {
  endpoint=$1
  archive=$2
  image=$3
  parse_endpoint "$endpoint"
  case "$ENDPOINT_TOOL" in
    nerdctl) endpoint_exec "$endpoint" save -o "$archive" "$image" ;;
    apple) endpoint_exec "$endpoint" image save --output "$archive" "$image" ;;
    *) endpoint_exec "$endpoint" image save -o "$archive" "$image" ;;
  esac
}

endpoint_image_load() {
  endpoint=$1
  archive=$2
  parse_endpoint "$endpoint"
  case "$ENDPOINT_TOOL" in
    nerdctl) endpoint_exec "$endpoint" load -i "$archive" ;;
    apple)
      if ! apple_image_load_is_safe; then
        printf 'ctx: Apple Container image import requires container newer than 1.3.0; update it before loading archives\n' >&2
        exit 1
      fi
      endpoint_exec "$endpoint" image load --input "$archive"
      ;;
    *) endpoint_exec "$endpoint" image load -i "$archive" ;;
  esac
}

endpoint_volume_export() {
  endpoint=$1
  volume=$2
  endpoint_exec "$endpoint" run --rm -v "$volume:/volume:ro" "$VOLUME_IMAGE" tar -C /volume -cf - .
}

endpoint_volume_import() {
  endpoint=$1
  volume=$2
  endpoint_exec "$endpoint" run --rm -i -v "$volume:/volume" "$VOLUME_IMAGE" tar -C /volume -xf -
}

build() {
  engine=docker
  case "${1:-}" in
    docker|podman|nerdctl) engine=$1; shift ;;
  esac
  cache_ref=
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --cache-ref)
        [ "$#" -ge 2 ] || { printf 'ctx: --cache-ref needs a registry reference\n' >&2; exit 2; }
        cache_ref=$2
        shift 2
        ;;
      --cache-ref=*)
        cache_ref=${1#--cache-ref=}
        shift
        ;;
      --)
        shift
        break
        ;;
      *) break ;;
    esac
  done
  [ -n "$cache_ref" ] || { printf 'ctx: build requires --cache-ref <registry-ref>\n' >&2; exit 2; }
  [ "$#" -gt 0 ] || { printf 'ctx: build needs build arguments\n' >&2; exit 2; }
  case "$engine" in
    docker)
      docker_exec buildx build \
        --cache-from "type=registry,ref=$cache_ref" \
        --cache-to "type=registry,ref=$cache_ref,mode=max" \
        "$@"
      ;;
    podman)
      podman_exec build --layers --cache-from "$cache_ref" --cache-to "$cache_ref" "$@"
      ;;
    nerdctl)
      nerdctl_exec build \
        --cache-from "type=registry,ref=$cache_ref" \
        --cache-to "type=registry,ref=$cache_ref,mode=max" \
        "$@"
      ;;
  esac
}

image_sync() {
  mode=registry
  if [ "${1:-}" = --tar ]; then mode=tar; shift; fi
  [ "$#" -ge 3 ] || { printf 'ctx: image sync needs source context, target context, and image names\n' >&2; exit 2; }
  source_context=$1
  target_context=$2
  shift 2
  if [ "$mode" = tar ]; then
    archive=$(mktemp "${TMPDIR:-/tmp}/ctx-image.XXXXXX")
    trap 'rm -f "$archive"' EXIT HUP INT TERM
    docker_context_exec "$source_context" image save -o "$archive" "$@"
    docker_context_exec "$target_context" image load -i "$archive"
    rm -f "$archive"
    trap - EXIT HUP INT TERM
  else
    for image in "$@"; do
      docker_context_exec "$source_context" image push "$image"
      docker_context_exec "$target_context" image pull "$image"
    done
  fi
}

image_copy() {
  [ "$#" -ge 3 ] || { printf 'ctx: image copy needs source endpoint, target endpoint, and image names\n' >&2; exit 2; }
  source_endpoint=$1
  target_endpoint=$2
  shift 2
  for image in "$@"; do
    archive=$(mktemp "${TMPDIR:-/tmp}/ctx-image.XXXXXX")
    trap 'rm -f "$archive"' EXIT HUP INT TERM
    endpoint_image_save "$source_endpoint" "$archive" "$image"
    endpoint_image_load "$target_endpoint" "$archive"
    rm -f "$archive"
    trap - EXIT HUP INT TERM
  done
}

volume_export() {
  [ "$#" -eq 2 ] || { printf 'ctx: volume export needs a source context and volume name\n' >&2; exit 2; }
  printf 'ctx: export is only crash-consistent; stop or quiesce databases first\n' >&2
  docker_context_exec "$1" run --rm -v "$2:/volume:ro" "$VOLUME_IMAGE" tar -C /volume -cf - .
}

volume_import() {
  [ "$#" -eq 2 ] || { printf 'ctx: volume import needs a target context and new volume name\n' >&2; exit 2; }
  target_context=$1
  volume=$2
  if docker_context_exec "$target_context" volume inspect "$volume" >/dev/null 2>&1; then
    printf 'ctx: target volume %s already exists; refusing to merge data\n' "$volume" >&2
    exit 1
  fi
  docker_context_exec "$target_context" volume create "$volume"
  docker_context_exec "$target_context" run --rm -i -v "$volume:/volume" "$VOLUME_IMAGE" tar -C /volume -xf -
}

volume_copy() {
  [ "$#" -ge 3 ] && [ "$#" -le 4 ] || { printf 'ctx: volume copy needs source endpoint, target endpoint, source volume, and optional target volume\n' >&2; exit 2; }
  source_endpoint=$1
  target_endpoint=$2
  source_volume=$3
  target_volume=${4:-$source_volume}
  printf 'ctx: copy is only crash-consistent; stop or quiesce databases first\n' >&2
  if endpoint_exec "$target_endpoint" volume inspect "$target_volume" >/dev/null 2>&1; then
    printf 'ctx: target volume %s already exists; refusing to merge data\n' "$target_volume" >&2
    exit 1
  fi
  archive=$(mktemp "${TMPDIR:-/tmp}/ctx-volume.XXXXXX")
  trap 'rm -f "$archive"' EXIT HUP INT TERM
  endpoint_volume_export "$source_endpoint" "$source_volume" > "$archive"
  endpoint_exec "$target_endpoint" volume create "$target_volume"
  endpoint_volume_import "$target_endpoint" "$target_volume" < "$archive"
  rm -f "$archive"
  trap - EXIT HUP INT TERM
}

write_choice() {
  key="$1"
  name="$2"
  file=.ctx
  tmp=$(mktemp)
  if [ -f "$file" ]; then
    awk -v key="$key" -v value="$name" '
      $0 ~ "^[[:space:]]*" key "[[:space:]]*=" {
        if (!written) { print key " = \"" value "\""; written=1 }
        next
      }
      { print }
      END { if (!written) print key " = \"" value "\"" }
    ' "$file" > "$tmp"
  else
    printf '%s = "%s"\n' "$key" "$name" > "$tmp"
  fi
  mv "$tmp" "$file"
  if git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    exclude=$(git rev-parse --path-format=absolute --git-path info/exclude)
    mkdir -p "$(dirname "$exclude")"
    if ! grep -Fxq .ctx "$exclude" 2>/dev/null; then printf '\n.ctx\n' >> "$exclude"; fi
  fi
}

write_default() {
  key="${1}_default"
  name="$2"
  mkdir -p "$CTX_HOME"
  [ -f "$CONFIG" ] || printf '# ctx fallbacks and project map\n' > "$CONFIG"
  tmp=$(mktemp)
  awk -v key="$key" -v value="$name" '
    BEGIN { print key " = \"" value "\"" }
    /^\[/ { in_section=1 }
    !in_section && $0 ~ "^[[:space:]]*" key "[[:space:]]*=" { next }
    { print }
  ' "$CONFIG" > "$tmp"
  mv "$tmp" "$CONFIG"
}

clear_choice() {
  tool="${1:-}"
  [ -f .ctx ] || return 0
  if [ -z "$tool" ]; then
    rm .ctx
    return
  fi
  check_tool "$tool"
  tmp=$(mktemp)
  awk -v key="$tool" '$0 !~ "^[[:space:]]*" key "[[:space:]]*="' .ctx > "$tmp"
  if grep -Eq '^[[:space:]]*(docker|podman|nerdctl)[[:space:]]*=' "$tmp"; then
    mv "$tmp" .ctx
  else
    rm .ctx "$tmp"
  fi
}

case "${1:-}" in
  ''|help|--help|-h) usage ;;
  version|--version|-v) printf 'ctx %s\n' "$VERSION" ;;
  real)
    check_tool "${2:-}"
    find_real "$2"
    ;;
  resolve)
    check_tool "${2:-}"
    resolve "$2"
    printf '%s\n' "$RESOLVED"
    ;;
  status)
    if [ -n "${2:-}" ]; then check_tool "$2"; status_one "$2"
    else status_one docker; status_one podman; status_one nerdctl; fi
    ;;
  ls)
    check_tool "${2:-}"
    real=$(find_real "$2")
    case "$2" in
      docker) "$real" context ls ;;
      podman) "$real" system connection list ;;
      nerdctl) "$real" namespace ls ;;
    esac
    ;;
  set)
    check_tool "${2:-}"
    name="${3:-}"
    [ -n "$name" ] || { usage >&2; exit 2; }
    if ! validate_choice "$2" "$name"; then
      printf 'ctx: unknown %s %s\n' "$2" "$name" >&2
      exit 1
    fi
    if [ "${4:-}" = --global ]; then
      write_default "$2" "$name"
      printf '%s fallback: %s\n' "$2" "$name"
    elif [ -z "${4:-}" ]; then
      write_choice "$2" "$name"
      printf '%s: %s in %s/.ctx\n' "$2" "$name" "$PWD"
    else
      usage >&2; exit 2
    fi
    ;;
  clear)
    clear_choice "${2:-}"
    printf 'cleared %s/.ctx\n' "$PWD"
    ;;
  build)
    shift
    build "$@"
    ;;
  image)
    case "${2:-}" in
      sync) shift 2; image_sync "$@" ;;
      copy) shift 2; image_copy "$@" ;;
      *) usage >&2; exit 2 ;;
    esac
    ;;
  volume)
    case "${2:-}" in
      export) shift 2; volume_export "$@" ;;
      import) shift 2; volume_import "$@" ;;
      copy) shift 2; volume_copy "$@" ;;
      *) usage >&2; exit 2 ;;
    esac
    ;;
  *) usage >&2; exit 2 ;;
esac
