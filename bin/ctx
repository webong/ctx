#!/usr/bin/env sh
# ctx command — project-local tool contexts and profile bundles
set -eu

CTX_HOME=${CTX_HOME:-$HOME/.config/ctx}
CONFIG="$CTX_HOME/config.toml"
ADAPTER_HOME=${CTX_ADAPTER_HOME:-$CTX_HOME/adapters}
ADAPTER_TRUST="$ADAPTER_HOME/trust"
ADAPTER_API=1
VERSION=0.7.0
VOLUME_IMAGE=${CTX_VOLUME_IMAGE:-alpine:3.21}

usage() {
  cat <<'HELP'
ctx — project-local tool contexts
usage:
  ctx status [selector]
  ctx ls <selector>
  ctx set <selector> <name> [options]
  ctx clear [selector|profile]
  ctx adapter <ls|inspect|install|trust|test|doctor|remove> [arguments...]
  ctx profile <ls|show|use|set|unset|env|env-unset|clear> [arguments...]
  ctx run <tool-or-adapter> [arguments...]
  ctx run -- <command> [arguments...]
  ctx shell [-- <command> [arguments...]]
  ctx env
  ctx open [--adapter <name>] [URL...]
  ctx explain
  ctx doctor
  ctx build [docker|podman|nerdctl] --cache-ref <registry-ref> [--] <build arguments>
  ctx image sync [--tar] <source-context> <target-context> <image>...
  ctx image copy <engine:endpoint> <engine:endpoint> <image>...
  ctx volume export <source-context> <volume> > volume.tar
  ctx volume import <target-context> <new-volume> < volume.tar
  ctx volume copy <engine:endpoint> <engine:endpoint> <source-volume> [target-volume]
  ctx version

Project choices are stored in .ctx. Container --global writes a fallback to
config.toml. Named bundles live in [profiles."name"] sections in config.toml.
External adapters are explicitly installed and trusted under CTX_HOME/adapters.
HELP
}

check_tool() {
  case "$1" in docker|podman|nerdctl) ;; *) printf 'ctx: use docker, podman, or nerdctl\n' >&2; exit 2;; esac
}

check_selector() {
  selector="$1"
  if is_builtin_selector "$selector" || selector_adapter_exists "$selector"; then return 0; fi
  printf 'ctx: unknown selector %s\n' "$selector" >&2
  exit 2
}

is_builtin_selector() {
  case "$1" in docker|podman|nerdctl|browser) return 0 ;; *) return 1 ;; esac
}

valid_adapter_name() {
  case "$1" in
    ''|*[!a-z0-9_]*|[0-9_]*) return 1 ;;
    docker|podman|nerdctl|browser|profile|shell|env|image|volume|build|adapter) return 1 ;;
    *) return 0 ;;
  esac
}

valid_config_key() {
  case "$1" in ''|*[!a-z0-9_]*|[0-9_]*) return 1 ;; *) return 0 ;; esac
}

manifest_value() {
  manifest_path="$1"
  manifest_lookup_key="$2"
  awk -v key="$manifest_lookup_key" '
    $0 ~ "^[[:space:]]*" key "[[:space:]]*=[[:space:]]*\"" {
      line=$0
      sub(/^[^\"]*\"/, "", line)
      sub(/\".*$/, "", line)
      print line
      exit
    }
  ' "$manifest_path"
}

adapter_exists() {
  valid_adapter_name "$1" && [ -f "$ADAPTER_HOME/$1/adapter.toml" ]
}

adapter_validate_directory() {
  source_dir="$1"
  [ -d "$source_dir" ] || { printf 'ctx: adapter directory not found: %s\n' "$source_dir" >&2; return 1; }
  source_dir=$(CDPATH= cd -- "$source_dir" && pwd)
  manifest="$source_dir/adapter.toml"
  [ -f "$manifest" ] || { printf 'ctx: adapter manifest not found: %s\n' "$manifest" >&2; return 1; }
  if find "$source_dir" -type l -print | grep -q .; then
    printf 'ctx: adapter packages cannot contain symbolic links: %s\n' "$source_dir" >&2
    return 1
  fi

  ADAPTER_API_VERSION=$(manifest_value "$manifest" api_version)
  ADAPTER_NAME=$(manifest_value "$manifest" name)
  ADAPTER_EXECUTABLE=$(manifest_value "$manifest" executable)
  ADAPTER_DESCRIPTION=$(manifest_value "$manifest" description)
  ADAPTER_CAPABILITIES=$(manifest_value "$manifest" capabilities)
  ADAPTER_KIND=$(manifest_value "$manifest" kind)
  ADAPTER_SELECTOR_KEY=$(manifest_value "$manifest" selector_key)
  ADAPTER_EXTRA_KEYS=$(manifest_value "$manifest" extra_keys)
  ADAPTER_COMMANDS=$(manifest_value "$manifest" commands)
  ADAPTER_FIRST_PARTY=$(manifest_value "$manifest" first_party)
  [ -n "$ADAPTER_KIND" ] || ADAPTER_KIND=selector
  if [ -z "$ADAPTER_SELECTOR_KEY" ]; then
    if [ "$ADAPTER_KIND" = browser ]; then ADAPTER_SELECTOR_KEY=browser
    else ADAPTER_SELECTOR_KEY=$ADAPTER_NAME
    fi
  fi
  if [ -z "$ADAPTER_COMMANDS" ] && [ "$ADAPTER_KIND" = selector ]; then ADAPTER_COMMANDS=$ADAPTER_NAME; fi
  ADAPTER_DIRECTORY=$source_dir
  ADAPTER_MANIFEST=$manifest

  [ "$ADAPTER_API_VERSION" = "$ADAPTER_API" ] || {
    printf 'ctx: adapter %s uses unsupported API %s (expected %s)\n' "${ADAPTER_NAME:-<unknown>}" "${ADAPTER_API_VERSION:-<missing>}" "$ADAPTER_API" >&2
    return 1
  }
  valid_adapter_name "$ADAPTER_NAME" || { printf 'ctx: invalid or reserved adapter name %s\n' "${ADAPTER_NAME:-<missing>}" >&2; return 1; }
  case "$ADAPTER_KIND" in selector|browser) ;; *) printf 'ctx: adapter %s has invalid kind %s\n' "$ADAPTER_NAME" "$ADAPTER_KIND" >&2; return 1 ;; esac
  valid_config_key "$ADAPTER_SELECTOR_KEY" || { printf 'ctx: adapter %s has invalid selector key %s\n' "$ADAPTER_NAME" "$ADAPTER_SELECTOR_KEY" >&2; return 1; }
  old_ifs=$IFS
  IFS=,
  for config_key in $ADAPTER_EXTRA_KEYS; do
    if ! valid_config_key "$config_key"; then IFS=$old_ifs; printf 'ctx: adapter %s has invalid extra key %s\n' "$ADAPTER_NAME" "$config_key" >&2; return 1; fi
  done
  for adapter_command_name in $ADAPTER_COMMANDS; do
    if ! valid_config_key "$adapter_command_name"; then IFS=$old_ifs; printf 'ctx: adapter %s has invalid command %s\n' "$ADAPTER_NAME" "$adapter_command_name" >&2; return 1; fi
  done
  IFS=$old_ifs
  case "$ADAPTER_EXECUTABLE" in
    ''|*/*|.*) printf 'ctx: adapter %s has an invalid executable name\n' "$ADAPTER_NAME" >&2; return 1 ;;
  esac
  ADAPTER_EXEC_PATH="$source_dir/$ADAPTER_EXECUTABLE"
  [ -f "$ADAPTER_EXEC_PATH" ] && [ -x "$ADAPTER_EXEC_PATH" ] || {
    printf 'ctx: adapter executable is missing or not executable: %s\n' "$ADAPTER_EXEC_PATH" >&2
    return 1
  }
  [ -n "$ADAPTER_CAPABILITIES" ] || { printf 'ctx: adapter %s has no capabilities\n' "$ADAPTER_NAME" >&2; return 1; }

  has_validate=0
  has_doctor=0
  has_action=0
  old_ifs=$IFS
  IFS=,
  for capability in $ADAPTER_CAPABILITIES; do
    case "$capability" in
      list) ;;
      configure) ;;
      validate) has_validate=1 ;;
      run|open) has_action=1 ;;
      doctor) has_doctor=1 ;;
      *) IFS=$old_ifs; printf 'ctx: adapter %s declares unknown capability %s\n' "$ADAPTER_NAME" "$capability" >&2; return 1 ;;
    esac
  done
  IFS=$old_ifs
  [ "$has_validate" -eq 1 ] && [ "$has_doctor" -eq 1 ] && [ "$has_action" -eq 1 ] || {
    printf 'ctx: adapter %s must provide validate, doctor, and run or open\n' "$ADAPTER_NAME" >&2
    return 1
  }
}

adapter_config_keys() {
  printf '%s\n' "$ADAPTER_SELECTOR_KEY"
  old_ifs=$IFS
  IFS=,
  for config_key in $ADAPTER_EXTRA_KEYS; do [ -n "$config_key" ] && printf '%s\n' "$config_key"; done
  IFS=$old_ifs
}

adapter_has_command() {
  requested_command="$1"
  case ",$ADAPTER_COMMANDS," in *",$requested_command,"*) return 0 ;; *) return 1 ;; esac
}

adapter_for_command() {
  requested_command="$1"
  COMMAND_ADAPTER=
  adapter_names_file=$(mktemp)
  list_adapter_names > "$adapter_names_file"
  while IFS= read -r possible_adapter; do
    [ -n "$possible_adapter" ] || continue
    if adapter_load "$possible_adapter" >/dev/null 2>&1 && [ "$ADAPTER_KIND" = selector ] && adapter_has_command "$requested_command"; then
      if [ -n "$COMMAND_ADAPTER" ]; then
        rm -f "$adapter_names_file"
        printf 'ctx: command %s is claimed by both %s and %s\n' "$requested_command" "$COMMAND_ADAPTER" "$possible_adapter" >&2
        return 1
      fi
      COMMAND_ADAPTER=$possible_adapter
    fi
  done < "$adapter_names_file"
  rm -f "$adapter_names_file"
  [ -n "$COMMAND_ADAPTER" ]
}

adapter_owns_config_key() {
  requested_key="$1"
  adapter_names_file=$(mktemp)
  list_adapter_names > "$adapter_names_file"
  while IFS= read -r possible_adapter; do
    [ -n "$possible_adapter" ] || continue
    if adapter_load "$possible_adapter" >/dev/null 2>&1 && [ "$ADAPTER_KIND" = selector ]; then
      if [ "$requested_key" = "$ADAPTER_SELECTOR_KEY" ]; then rm -f "$adapter_names_file"; return 0; fi
      case ",$ADAPTER_EXTRA_KEYS," in *",$requested_key,"*) rm -f "$adapter_names_file"; return 0 ;; esac
    fi
  done < "$adapter_names_file"
  rm -f "$adapter_names_file"
  return 1
}

adapter_load() {
  adapter_load_name="$1"
  adapter_validate_directory "$ADAPTER_HOME/$adapter_load_name" || return 1
  [ "$ADAPTER_NAME" = "$adapter_load_name" ] || {
    printf 'ctx: adapter directory %s contains manifest for %s\n' "$adapter_load_name" "$ADAPTER_NAME" >&2
    return 1
  }
}

selector_adapter_exists() {
  adapter_exists "$1" || return 1
  adapter_load "$1" >/dev/null 2>&1 || return 1
  [ "$ADAPTER_KIND" = selector ]
}

adapter_has_capability() {
  capability="$1"
  case ",$ADAPTER_CAPABILITIES," in *",$capability,"*) return 0 ;; *) return 1 ;; esac
}

adapter_checksum() {
  if command -v shasum >/dev/null 2>&1; then
    (
      cd "$ADAPTER_DIRECTORY"
      find . -type f -print | LC_ALL=C sort | while IFS= read -r adapter_file; do
        printf '%s ' "$adapter_file"
        shasum -a 256 "$adapter_file" | awk '{ print $1 }'
      done
    ) | shasum -a 256 | awk '{ print $1 }'
  elif command -v sha256sum >/dev/null 2>&1; then
    (
      cd "$ADAPTER_DIRECTORY"
      find . -type f -print | LC_ALL=C sort | while IFS= read -r adapter_file; do
        printf '%s ' "$adapter_file"
        sha256sum "$adapter_file" | awk '{ print $1 }'
      done
    ) | sha256sum | awk '{ print $1 }'
  else
    printf 'ctx: shasum or sha256sum is required for adapter trust\n' >&2
    return 127
  fi
}

adapter_is_trusted_loaded() {
  [ -f "$ADAPTER_TRUST" ] || return 1
  checksum=$(adapter_checksum) || return 1
  awk -v name="$ADAPTER_NAME" -v checksum="$checksum" '$1 == name && $2 == checksum { found=1 } END { exit !found }' "$ADAPTER_TRUST"
}

adapter_assert_trusted_loaded() {
  adapter_is_trusted_loaded && return 0
  printf 'ctx: adapter %s is not trusted or changed; run ctx adapter trust %s after reviewing it\n' "$ADAPTER_NAME" "$ADAPTER_NAME" >&2
  return 1
}

adapter_export_config() {
  config_keys_file=$(mktemp)
  adapter_config_keys > "$config_keys_file"
  while IFS= read -r config_key; do
    [ -n "$config_key" ] || continue
    resolve_key "$config_key"
    config_value=$RESOLVED
    config_env_key=$(printf '%s' "$config_key" | tr '[:lower:]' '[:upper:]')
    export "CTX_ADAPTER_VALUE_$config_env_key=$config_value"
  done < "$config_keys_file"
  rm -f "$config_keys_file"
}

list_adapter_names() {
  [ -d "$ADAPTER_HOME" ] || return 0
  for adapter_dir in "$ADAPTER_HOME"/*; do
    [ -d "$adapter_dir" ] || continue
    listed_adapter_name=${adapter_dir##*/}
    valid_adapter_name "$listed_adapter_name" || continue
    [ -f "$adapter_dir/adapter.toml" ] || continue
    printf '%s\n' "$listed_adapter_name"
  done
}

adapter_invoke() {
  invoke_adapter_name="$1"
  invoke_operation="$2"
  invoke_selection="$3"
  shift 3
  adapter_load "$invoke_adapter_name"
  adapter_assert_trusted_loaded
  adapter_has_capability "$invoke_operation" || {
    printf 'ctx: adapter %s does not support %s\n' "$invoke_adapter_name" "$invoke_operation" >&2
    return 2
  }
  resolve_key profile
  adapter_profile=$RESOLVED
  adapter_export_config
  adapter_requested_command=${ADAPTER_REQUESTED_COMMAND:-$invoke_adapter_name}
  case "$invoke_operation" in
    list)
      CTX_ADAPTER_API=$ADAPTER_API CTX_ADAPTER_NAME=$invoke_adapter_name CTX_ADAPTER_COMMAND=$adapter_requested_command CTX_PROJECT_DIR=$PWD CTX_PROFILE=$adapter_profile \
        "$ADAPTER_EXEC_PATH" list
      ;;
    validate|doctor)
      CTX_ADAPTER_API=$ADAPTER_API CTX_ADAPTER_NAME=$invoke_adapter_name CTX_ADAPTER_COMMAND=$adapter_requested_command CTX_PROJECT_DIR=$PWD CTX_PROFILE=$adapter_profile \
        "$ADAPTER_EXEC_PATH" "$invoke_operation" "$invoke_selection"
      ;;
    configure|run|open)
      CTX_ADAPTER_API=$ADAPTER_API CTX_ADAPTER_NAME=$invoke_adapter_name CTX_ADAPTER_COMMAND=$adapter_requested_command CTX_PROJECT_DIR=$PWD CTX_PROFILE=$adapter_profile \
        "$ADAPTER_EXEC_PATH" "$invoke_operation" "$invoke_selection" -- "$@"
      ;;
  esac
}

adapter_trust_loaded() {
  checksum=$(adapter_checksum)
  mkdir -p "$ADAPTER_HOME"
  tmp=$(mktemp)
  if [ -f "$ADAPTER_TRUST" ]; then
    awk -v name="$ADAPTER_NAME" '$1 != name' "$ADAPTER_TRUST" > "$tmp"
  fi
  printf '%s %s\n' "$ADAPTER_NAME" "$checksum" >> "$tmp"
  mv "$tmp" "$ADAPTER_TRUST"
  chmod 600 "$ADAPTER_TRUST"
}

adapter_remove_trust() {
  name="$1"
  [ -f "$ADAPTER_TRUST" ] || return 0
  tmp=$(mktemp)
  awk -v name="$name" '$1 != name' "$ADAPTER_TRUST" > "$tmp"
  mv "$tmp" "$ADAPTER_TRUST"
  chmod 600 "$ADAPTER_TRUST"
}

adapter_install() {
  [ "$#" -eq 1 ] || { printf 'ctx: adapter install needs a source directory\n' >&2; exit 2; }
  source_dir=$1
  adapter_validate_directory "$source_dir"
  target="$ADAPTER_HOME/$ADAPTER_NAME"
  [ ! -e "$target" ] || { printf 'ctx: adapter %s is already installed\n' "$ADAPTER_NAME" >&2; exit 1; }
  mkdir -p "$ADAPTER_HOME"
  install_stage=$(mktemp -d "$ADAPTER_HOME/.install.XXXXXX")
  trap 'rm -rf "$install_stage"' EXIT HUP INT TERM
  cp -R "$ADAPTER_DIRECTORY/." "$install_stage/"
  mv "$install_stage" "$target"
  trap - EXIT HUP INT TERM
  printf 'installed adapter %s in %s (untrusted)\n' "$ADAPTER_NAME" "$target"
  printf 'review it, then run: ctx adapter trust %s\n' "$ADAPTER_NAME"
}

adapter_list() {
  list_adapter_names | while IFS= read -r name; do
    [ -n "$name" ] || continue
    if adapter_load "$name" >/dev/null 2>&1; then
      if adapter_is_trusted_loaded; then state=trusted; else state=untrusted; fi
      printf '%-16s %-10s %s\n' "$name" "$state" "${ADAPTER_DESCRIPTION:-}"
    else
      printf '%-16s invalid\n' "$name"
    fi
  done
}

adapter_inspect() {
  [ "$#" -eq 1 ] || { printf 'ctx: adapter inspect needs a name\n' >&2; exit 2; }
  adapter_load "$1"
  if adapter_is_trusted_loaded; then state=trusted; else state=untrusted; fi
  printf 'name:         %s\n' "$ADAPTER_NAME"
  printf 'api:          %s\n' "$ADAPTER_API_VERSION"
  printf 'kind:         %s\n' "$ADAPTER_KIND"
  printf 'state:        %s\n' "$state"
  printf 'capabilities: %s\n' "$ADAPTER_CAPABILITIES"
  printf 'executable:   %s\n' "$ADAPTER_EXEC_PATH"
  printf 'description:  %s\n' "$ADAPTER_DESCRIPTION"
}

adapter_test() {
  [ "$#" -eq 1 ] || { printf 'ctx: adapter test needs an adapter directory\n' >&2; exit 2; }
  adapter_validate_directory "$1"
  CTX_ADAPTER_API=$ADAPTER_API CTX_ADAPTER_NAME=$ADAPTER_NAME CTX_PROJECT_DIR=$PWD CTX_PROFILE= \
    "$ADAPTER_EXEC_PATH" doctor ''
  printf 'adapter %s satisfies ctx adapter API v%s\n' "$ADAPTER_NAME" "$ADAPTER_API"
}

adapter_command() {
  action="${1:-}"
  case "$action" in
    ls|list) [ "$#" -eq 1 ] || { printf 'ctx: adapter ls takes no arguments\n' >&2; exit 2; }; adapter_list ;;
    inspect) shift; adapter_inspect "$@" ;;
    install) shift; adapter_install "$@" ;;
    trust)
      name="${2:-}"
      [ "$#" -eq 2 ] || { printf 'ctx: adapter trust needs a name\n' >&2; exit 2; }
      adapter_load "$name"
      adapter_trust_loaded
      printf 'trusted adapter %s\n' "$name"
      ;;
    test) shift; adapter_test "$@" ;;
    doctor)
      name="${2:-}"
      [ "$#" -eq 2 ] || { printf 'ctx: adapter doctor needs a name\n' >&2; exit 2; }
      adapter_load "$name"
      resolve_key "$ADAPTER_SELECTOR_KEY"
      selection=$RESOLVED
      if [ "$ADAPTER_KIND" = browser ] && [ -n "$selection" ]; then
        parse_browser_choice "$selection" || { printf 'ctx: invalid browser selection %s\n' "$selection" >&2; exit 1; }
        if [ "$BROWSER_ENGINE" = "$name" ]; then selection=$BROWSER_PROFILE; else selection=; fi
      fi
      adapter_invoke "$name" doctor "$selection"
      ;;
    remove)
      name="${2:-}"
      [ "$#" -eq 2 ] || { printf 'ctx: adapter remove needs a name\n' >&2; exit 2; }
      valid_adapter_name "$name" || { printf 'ctx: invalid adapter name %s\n' "$name" >&2; exit 2; }
      target="$ADAPTER_HOME/$name"
      [ -d "$target" ] || { printf 'ctx: adapter %s is not installed\n' "$name" >&2; exit 1; }
      rm -rf "$target"
      adapter_remove_trust "$name"
      printf 'removed adapter %s\n' "$name"
      ;;
    *) printf 'ctx: adapter requires ls, inspect, install, trust, test, doctor, or remove\n' >&2; exit 2 ;;
  esac
}

find_real() {
  tool="$1"
  remaining="$PATH:"
  while [ -n "$remaining" ]; do
    part=${remaining%%:*}
    remaining=${remaining#*:}
    [ -n "$part" ] || part=.
    candidate="$part/$tool"
    if [ -x "$candidate" ] && ! (dd if="$candidate" bs=256 count=1 2>/dev/null | grep -Eq 'ctx wrapper|dctx shim'); then
      printf '%s\n' "$candidate"
      return 0
    fi
  done
  printf 'ctx: %s CLI not found on PATH\n' "$tool" >&2
  return 127
}

read_choice() {
  file="$1"
  key="$2"
  [ -f "$file" ] || return 0
  awk -v key="$key" '
    $0 ~ "^[[:space:]]*" key "[[:space:]]*=[[:space:]]*\"" {
      line=$0
      sub(/^[[:space:]]*[a-z][a-z0-9_]*[[:space:]]*=[[:space:]]*"/, "", line)
      sub(/".*$/, "", line)
      if (line != "") { print line; exit }
    }
  ' "$file"
}

read_project_map() {
  dir="$1"
  tool="$2"
  [ -f "$CONFIG" ] || return 0
  awk -v section="[projects.\"$dir\"]" -v key="$tool" '
    /^\[/ { active=($0 == section); next }
    active && $0 ~ "^[[:space:]]*" key "[[:space:]]*=[[:space:]]*\"" {
      line=$0
      sub(/^[[:space:]]*[a-z][a-z0-9_]*[[:space:]]*=[[:space:]]*"/, "", line)
      sub(/".*$/, "", line)
      if (line != "") { print line; exit }
    }
  ' "$CONFIG"
}

read_profile_choice() {
  profile="$1"
  key="$2"
  [ -f "$CONFIG" ] || return 0
  awk -v section="[profiles.\"$profile\"]" -v key="$key" '
    /^\[/ { active=($0 == section); next }
    active && $0 ~ "^[[:space:]]*" key "[[:space:]]*=[[:space:]]*\"" {
      line=$0
      sub(/^[[:space:]]*[a-z][a-z0-9_]*[[:space:]]*=[[:space:]]*\"/, "", line)
      sub(/\".*$/, "", line)
      if (line != "") { print line; exit }
    }
  ' "$CONFIG"
}

profile_exists() {
  profile="$1"
  [ -f "$CONFIG" ] || return 1
  awk -v section="[profiles.\"$profile\"]" '$0 == section { found=1 } END { exit !found }' "$CONFIG"
}

list_profiles() {
  [ -f "$CONFIG" ] || return 0
  awk '
    /^\[profiles\."[^"]+"\]$/ {
      line=$0
      sub(/^\[profiles\."/, "", line)
      sub(/"\]$/, "", line)
      print line
    }
  ' "$CONFIG"
}

valid_profile_name() {
  case "$1" in ''|*[!A-Za-z0-9._-]*) return 1 ;; *) return 0 ;; esac
}

valid_profile_key() {
  case "$1" in
    docker|podman|nerdctl|browser|shell_path) return 0 ;;
    *) adapter_owns_config_key "$1" ;;
  esac
}

valid_env_key() {
  case "$1" in
    [A-Za-z_]* ) case "$1" in *[!A-Za-z0-9_]*) return 1 ;; *) return 0 ;; esac ;;
    *) return 1 ;;
  esac
}

ensure_profile() {
  profile="$1"
  profile_exists "$profile" && return 0
  mkdir -p "$CTX_HOME"
  [ -f "$CONFIG" ] || printf '# ctx fallbacks, project maps, and profiles\n' > "$CONFIG"
  printf '\n[profiles."%s"]\n' "$profile" >> "$CONFIG"
}

read_profile_env() {
  profile="$1"
  [ -f "$CONFIG" ] || return 0
  awk -v section="[profiles.\"$profile\".env]" '
    /^\[/ { active=($0 == section); next }
    active && $0 ~ "^[[:space:]]*[A-Za-z_][A-Za-z0-9_]*[[:space:]]*=[[:space:]]*\"" {
      key=$0
      sub(/^[[:space:]]*/, "", key)
      sub(/[[:space:]]*=.*$/, "", key)
      value=$0
      sub(/^[[:space:]]*[A-Za-z_][A-Za-z0-9_]*[[:space:]]*=[[:space:]]*\"/, "", value)
      sub(/\".*$/, "", value)
      print key "\t" value
    }
  ' "$CONFIG"
}

write_profile_env() {
  profile="$1"
  key="$2"
  value="$3"
  ensure_profile "$profile"
  section="[profiles.\"$profile\".env]"
  tmp=$(mktemp)
  awk -v section="$section" -v key="$key" -v value="$value" '
    $0 == section { active=1; found=1; print; next }
    active && /^\[/ {
      if (!written) { print key " = \"" value "\""; written=1 }
      active=0
    }
    active && $0 ~ "^[[:space:]]*" key "[[:space:]]*=" {
      if (!written) { print key " = \"" value "\""; written=1 }
      next
    }
    { print }
    END {
      if (active && !written) print key " = \"" value "\""
      if (!found) {
        print ""
        print section
        print key " = \"" value "\""
      }
    }
  ' "$CONFIG" > "$tmp"
  mv "$tmp" "$CONFIG"
}

unset_profile_env() {
  profile="$1"
  key="$2"
  [ -f "$CONFIG" ] || return 0
  section="[profiles.\"$profile\".env]"
  tmp=$(mktemp)
  awk -v section="$section" -v key="$key" '
    /^\[/ { active=($0 == section) }
    active && $0 ~ "^[[:space:]]*" key "[[:space:]]*=" { next }
    { print }
  ' "$CONFIG" > "$tmp"
  mv "$tmp" "$CONFIG"
}

show_profile() {
  profile="$1"
  [ -f "$CONFIG" ] || return 0
  awk -v section="[profiles.\"$profile\"]" -v env_section="[profiles.\"$profile\".env]" '
    /^\[/ {
      if ($0 == section) { active=1; next }
      if ($0 == env_section) { active=1; print "[env]"; next }
      active=0
      next
    }
    active { print }
  ' "$CONFIG"
}

write_profile_choice() {
  profile="$1"
  key="$2"
  value="$3"
  mkdir -p "$CTX_HOME"
  [ -f "$CONFIG" ] || printf '# ctx fallbacks, project maps, and profiles\n' > "$CONFIG"
  tmp=$(mktemp)
  awk -v section="[profiles.\"$profile\"]" -v key="$key" -v value="$value" '
    $0 == section { active=1; found=1; print; next }
    active && /^\[/ {
      if (!written) { print key " = \"" value "\""; written=1 }
      active=0
    }
    active && $0 ~ "^[[:space:]]*" key "[[:space:]]*=" {
      if (!written) { print key " = \"" value "\""; written=1 }
      next
    }
    { print }
    END {
      if (active && !written) print key " = \"" value "\""
      if (!found) {
        print ""
        print section
        print key " = \"" value "\""
      }
    }
  ' "$CONFIG" > "$tmp"
  mv "$tmp" "$CONFIG"
}

unset_profile_choice() {
  profile="$1"
  key="$2"
  [ -f "$CONFIG" ] || return 0
  tmp=$(mktemp)
  awk -v section="[profiles.\"$profile\"]" -v key="$key" '
    /^\[/ { active=($0 == section) }
    active && $0 ~ "^[[:space:]]*" key "[[:space:]]*=" { next }
    { print }
  ' "$CONFIG" > "$tmp"
  mv "$tmp" "$CONFIG"
}

read_default() {
  tool="$1"
  [ -f "$CONFIG" ] || return 0
  awk -v key="${tool}_default" '
    /^\[/ { exit }
    $0 ~ "^[[:space:]]*" key "[[:space:]]*=[[:space:]]*\"" {
      line=$0
      sub(/^[[:space:]]*[a-z][a-z0-9_]*[[:space:]]*=[[:space:]]*"/, "", line)
      sub(/".*$/, "", line)
      if (line != "") { print line; exit }
    }
  ' "$CONFIG"
}

probe_docker() {
  real=$(find_real docker 2>/dev/null || true)
  [ -n "$real" ] || return 0
  orb=0
  desktop=0
  if [ -S "$HOME/.orbstack/run/docker.sock" ] && "$real" --context orbstack info >/dev/null 2>&1; then orb=1; fi
  if [ -S "$HOME/.docker/run/docker.sock" ] && "$real" --context desktop-linux info >/dev/null 2>&1; then desktop=1; fi
  if [ "$orb" = 1 ] && [ "$desktop" = 0 ]; then
    RESOLVED=orbstack; VIA='OrbStack daemon'
  elif [ "$desktop" = 1 ] && [ "$orb" = 0 ]; then
    RESOLVED=desktop-linux; VIA='Docker Desktop daemon'
  elif [ "$orb" = 1 ] && [ "$desktop" = 1 ]; then
    orb_time=$(stat -f %m "$HOME/.orbstack/run/docker.sock" 2>/dev/null || stat -c %Y "$HOME/.orbstack/run/docker.sock" 2>/dev/null || printf 0)
    desktop_time=$(stat -f %m "$HOME/.docker/run/docker.sock" 2>/dev/null || stat -c %Y "$HOME/.docker/run/docker.sock" 2>/dev/null || printf 0)
    if [ "$desktop_time" -gt "$orb_time" ]; then
      RESOLVED=desktop-linux; VIA='newer Docker Desktop socket'
    else
      RESOLVED=orbstack; VIA='newer OrbStack socket'
    fi
  fi
}

resolve_key() {
  key="$1"
  RESOLVED=
  VIA=
  dir="$PWD"
  while :; do
    choice=$(read_choice "$dir/.ctx" "$key")
    if [ -n "$choice" ]; then
      RESOLVED="$choice"; VIA="$dir/.ctx"; return
    fi
    if [ "$key" != profile ]; then
      profile=$(read_choice "$dir/.ctx" profile)
      if [ -n "$profile" ]; then
        choice=$(read_profile_choice "$profile" "$key")
        if [ -n "$choice" ]; then
          RESOLVED="$choice"; VIA="$CONFIG profile $profile"; return
        fi
      fi
    fi
    choice=$(read_project_map "$dir" "$key")
    if [ -n "$choice" ]; then
      RESOLVED="$choice"; VIA="$CONFIG project map"; return
    fi
    if [ "$key" != profile ]; then
      profile=$(read_project_map "$dir" profile)
      if [ -n "$profile" ]; then
        choice=$(read_profile_choice "$profile" "$key")
        if [ -n "$choice" ]; then
          RESOLVED="$choice"; VIA="$CONFIG project profile $profile"; return
        fi
      fi
    fi
    if [ "$dir" = "$HOME" ] || [ "$dir" = / ]; then break; fi
    dir=$(dirname "$dir")
  done
  if [ "$key" = docker ]; then probe_docker; fi
  if [ -n "$RESOLVED" ]; then return; fi
  choice=$(read_default "$key")
  if [ -n "$choice" ]; then
    RESOLVED="$choice"; VIA="$CONFIG default"
  else
    VIA="$key default"
  fi
}

resolve() {
  resolve_key "$1"
}

status_one() {
  tool="$1"
  case "$tool" in
    docker)
      if [ -n "${DOCKER_CONTEXT:-}" ]; then printf 'docker: %s (DOCKER_CONTEXT)\n' "$DOCKER_CONTEXT"; return; fi
      if [ -n "${DOCKER_HOST:-}" ]; then printf 'docker: %s (DOCKER_HOST)\n' "$DOCKER_HOST"; return; fi
      ;;
    podman)
      if [ -n "${CONTAINER_CONNECTION:-}" ]; then printf 'podman: %s (CONTAINER_CONNECTION)\n' "$CONTAINER_CONNECTION"; return; fi
      if [ -n "${CONTAINER_HOST:-}" ]; then printf 'podman: %s (CONTAINER_HOST)\n' "$CONTAINER_HOST"; return; fi
      ;;
    nerdctl)
      if [ -n "${CONTAINERD_NAMESPACE:-}" ]; then printf 'nerdctl: %s (CONTAINERD_NAMESPACE)\n' "$CONTAINERD_NAMESPACE"; return; fi
      ;;
    browser)
      if [ -n "${CTX_BROWSER:-}" ]; then printf 'browser: %s (CTX_BROWSER)\n' "$CTX_BROWSER"; return; fi
      resolve_key browser
      if [ -n "$RESOLVED" ]; then printf 'browser: %s (%s)\n' "$RESOLVED" "$VIA"
      else printf 'browser: <not selected>\n'; fi
      return
      ;;
  esac
  if adapter_exists "$tool"; then
    adapter_load "$tool"
    resolve_key "$ADAPTER_SELECTOR_KEY"
    if [ -n "$RESOLVED" ]; then printf '%s: %s (%s)\n' "$tool" "$RESOLVED" "$VIA"
    else printf '%s: <not selected>\n' "$tool"; fi
    return
  fi
  resolve "$tool"
  if [ -n "$RESOLVED" ]; then printf '%s: %s (%s)\n' "$tool" "$RESOLVED" "$VIA"
  elif adapter_exists "$tool"; then printf '%s: <not selected>\n' "$tool"
  else printf '%s: %s\n' "$tool" "$VIA"; fi
}

validate_choice() {
  tool="$1"
  name="$2"
  if [ "$tool" = apple ]; then real=$(find_real container)
  else real=$(find_real "$tool"); fi
  case "$tool" in
    docker) "$real" context inspect "$name" >/dev/null 2>&1 ;;
    podman) "$real" system connection list --format '{{.Name}}' | grep -Fxq "$name" ;;
    nerdctl) "$real" namespace ls --quiet | grep -Fxq "$name" ;;
    apple) [ "$name" = local ] && "$real" system version >/dev/null 2>&1 ;;
    *) return 1 ;;
  esac
}

validate_selector() {
  selector="$1"
  name="$2"
  case "$selector" in
    docker|podman|nerdctl) validate_choice "$selector" "$name" ;;
    browser) validate_browser_choice "$name" ;;
  esac
}

parse_browser_choice() {
  choice="$1"
  case "$choice" in
    *:*) BROWSER_ENGINE=${choice%%:*}; BROWSER_PROFILE=${choice#*:} ;;
    *) return 1 ;;
  esac
  [ -n "$BROWSER_ENGINE" ] && [ -n "$BROWSER_PROFILE" ] || return 1
  adapter_exists "$BROWSER_ENGINE" || return 1
  adapter_load "$BROWSER_ENGINE" >/dev/null 2>&1 || return 1
  [ "$ADAPTER_KIND" = browser ]
}

browser_list() {
  browser_list_file=$(mktemp)
  browser_adapters_file=$(mktemp)
  list_adapter_names > "$browser_adapters_file"
  while IFS= read -r browser_adapter; do
    [ -n "$browser_adapter" ] || continue
    if adapter_load "$browser_adapter" >/dev/null 2>&1 && [ "$ADAPTER_KIND" = browser ] && adapter_is_trusted_loaded; then
      adapter_invoke "$browser_adapter" list '' >> "$browser_list_file"
    fi
  done < "$browser_adapters_file"
  rm -f "$browser_adapters_file"

  if [ -s "$browser_list_file" ]; then
    cat "$browser_list_file"
    rm -f "$browser_list_file"
    return 0
  fi
  rm -f "$browser_list_file"
  printf 'ctx: no supported browser profiles found\n' >&2
  return 1
}

validate_browser_choice() {
  parse_browser_choice "$1" || return 1
  adapter_invoke "$BROWSER_ENGINE" validate "$BROWSER_PROFILE"
}

browser_open() {
  if [ "${1:-}" = -- ]; then shift; fi
  if [ -n "${CTX_BROWSER:-}" ]; then choice=$CTX_BROWSER
  else resolve_key browser; choice=$RESOLVED
  fi
  [ -n "$choice" ] || { printf 'ctx: no browser selected; use a value from ctx ls browser\n' >&2; exit 1; }
  if ! parse_browser_choice "$choice"; then
    printf 'ctx: invalid browser selection %s\n' "$choice" >&2
    exit 1
  fi
  adapter_invoke "$BROWSER_ENGINE" open "$BROWSER_PROFILE" "$@"
}

open_command() {
  if [ "${1:-}" = --adapter ]; then
    name="${2:-}"
    [ -n "$name" ] || { printf 'ctx: open --adapter needs a name\n' >&2; exit 2; }
    shift 2
    if [ "${1:-}" = -- ]; then shift; fi
    adapter_load "$name"
    resolve_key "$ADAPTER_SELECTOR_KEY"
    selection=$RESOLVED
    if [ "$ADAPTER_KIND" = browser ] && [ -n "$selection" ]; then
      parse_browser_choice "$selection" || { printf 'ctx: invalid browser selection %s\n' "$selection" >&2; exit 1; }
      [ "$BROWSER_ENGINE" = "$name" ] || { printf 'ctx: selected browser uses %s, not %s\n' "$BROWSER_ENGINE" "$name" >&2; exit 1; }
      selection=$BROWSER_PROFILE
    fi
    [ -n "$selection" ] || { printf 'ctx: no %s selection; run ctx set %s <name>\n' "$name" "$name" >&2; exit 1; }
    adapter_invoke "$name" open "$selection" "$@"
  else
    browser_open "$@"
  fi
}

apply_profile_environment() {
  resolve_key profile
  active_profile=$RESOLVED
  if [ -n "$active_profile" ]; then
    env_file=$(mktemp)
    read_profile_env "$active_profile" > "$env_file"
    tab=$(printf '\t')
    while IFS="$tab" read -r env_key env_value; do
      [ -n "$env_key" ] || continue
      if env | grep -q "^${env_key}="; then continue; fi
      export "$env_key=$env_value"
    done < "$env_file"
    rm -f "$env_file"
  fi

  resolve_key shell_path
  if [ -n "$RESOLVED" ]; then PATH="$RESOLVED:$PATH"; export PATH; fi
}

show_environment() {
  apply_profile_environment
  resolve_key profile
  active_profile=$RESOLVED
  if [ -n "$active_profile" ]; then
    env_file=$(mktemp)
    read_profile_env "$active_profile" > "$env_file"
    tab=$(printf '\t')
    while IFS="$tab" read -r env_key env_value; do
      [ -n "$env_key" ] || continue
      env_value=$(printenv "$env_key" 2>/dev/null || true)
      printf '%s=%s\n' "$env_key" "$env_value"
    done < "$env_file"
    rm -f "$env_file"
  fi
  resolve_key shell_path
  if [ -n "$RESOLVED" ]; then printf 'PATH=%s\n' "$PATH"; fi
}

shell_command() {
  apply_profile_environment
  if [ "${1:-}" = -- ]; then
    shift
    [ "$#" -gt 0 ] || { printf 'ctx: shell -- needs a command\n' >&2; exit 2; }
    exec "$@"
  fi
  [ "$#" -eq 0 ] || { printf 'ctx: shell only accepts -- followed by a command\n' >&2; exit 2; }
  shell=${SHELL:-/bin/sh}
  exec "$shell" -i
}

run_tool() {
  tool="${1:-}"
  [ -n "$tool" ] || { printf 'ctx: run needs a tool name\n' >&2; exit 2; }
  shift
  apply_profile_environment
  case "$tool" in
    --)
      [ "$#" -gt 0 ] || { printf 'ctx: run -- needs a command\n' >&2; exit 2; }
      "$@"
      ;;
    docker) docker_exec "$@" ;;
    podman) podman_exec "$@" ;;
    nerdctl) nerdctl_exec "$@" ;;
    *)
      if adapter_exists "$tool"; then selected_adapter=$tool
      elif adapter_for_command "$tool"; then selected_adapter=$COMMAND_ADAPTER
      else
        printf 'ctx: no adapter for %s\n' "$tool" >&2
        exit 2
      fi
      adapter_load "$selected_adapter"
      resolve_key "$ADAPTER_SELECTOR_KEY"
      selection=$RESOLVED
      [ -n "$selection" ] || { printf 'ctx: no %s selection; run ctx set %s <name>\n' "$selected_adapter" "$selected_adapter" >&2; exit 1; }
      ADAPTER_REQUESTED_COMMAND=$tool adapter_invoke "$selected_adapter" run "$selection" "$@"
      ;;
  esac
}

docker_exec() {
  real=$(find_real docker)
  if [ -n "${DOCKER_CONTEXT:-}" ] || [ -n "${DOCKER_HOST:-}" ]; then
    "$real" "$@"
    return
  fi
  resolve docker
  if [ -n "$RESOLVED" ]; then
    "$real" --context "$RESOLVED" "$@"
  else
    "$real" "$@"
  fi
}

podman_exec() {
  real=$(find_real podman)
  if [ -n "${CONTAINER_CONNECTION:-}" ] || [ -n "${CONTAINER_HOST:-}" ]; then
    "$real" "$@"
    return
  fi
  resolve podman
  if [ -n "$RESOLVED" ]; then
    "$real" --connection "$RESOLVED" "$@"
  else
    "$real" "$@"
  fi
}

nerdctl_exec() {
  real=$(find_real nerdctl)
  if [ -n "${CONTAINERD_NAMESPACE:-}" ] || [ -n "${CONTAINERD_ADDRESS:-}" ]; then
    "$real" "$@"
    return
  fi
  resolve nerdctl
  if [ -n "$RESOLVED" ]; then
    "$real" --namespace "$RESOLVED" "$@"
  else
    "$real" "$@"
  fi
}

docker_context_exec() {
  context=$1
  shift
  if ! validate_choice docker "$context"; then
    printf 'ctx: unknown Docker context %s\n' "$context" >&2
    exit 1
  fi
  real=$(find_real docker)
  "$real" --context "$context" "$@"
}

parse_endpoint() {
  endpoint=$1
  case "$endpoint" in
    docker:*) ENDPOINT_TOOL=docker; ENDPOINT_NAME=${endpoint#docker:} ;;
    podman:*) ENDPOINT_TOOL=podman; ENDPOINT_NAME=${endpoint#podman:} ;;
    nerdctl:*) ENDPOINT_TOOL=nerdctl; ENDPOINT_NAME=${endpoint#nerdctl:} ;;
    apple:*) ENDPOINT_TOOL=apple; ENDPOINT_NAME=${endpoint#apple:} ;;
    *)
      printf 'ctx: endpoint must be docker:<context>, podman:<connection>, nerdctl:<namespace>, or apple:local\n' >&2
      exit 2
      ;;
  esac
  [ -n "$ENDPOINT_NAME" ] || {
    printf 'ctx: endpoint name cannot be empty\n' >&2
    exit 2
  }
}

endpoint_exec() {
  endpoint=$1
  shift
  parse_endpoint "$endpoint"
  if ! validate_choice "$ENDPOINT_TOOL" "$ENDPOINT_NAME"; then
    printf 'ctx: unknown %s endpoint %s\n' "$ENDPOINT_TOOL" "$ENDPOINT_NAME" >&2
    exit 1
  fi
  case "$ENDPOINT_TOOL" in
    docker)
      real=$(find_real docker)
      "$real" --context "$ENDPOINT_NAME" "$@"
      ;;
    podman)
      real=$(find_real podman)
      "$real" --connection "$ENDPOINT_NAME" "$@"
      ;;
    nerdctl)
      real=$(find_real nerdctl)
      "$real" --namespace "$ENDPOINT_NAME" "$@"
      ;;
    apple)
      real=$(find_real container)
      "$real" "$@"
      ;;
  esac
}

apple_image_load_is_safe() {
  real=$(find_real container)
  version=$("$real" --version 2>/dev/null | sed -n 's/.*version \([0-9][0-9]*\.[0-9][0-9]*\.[0-9][0-9]*\).*/\1/p' | head -n 1)
  [ -n "$version" ] || return 1
  awk -F. -v version="$version" 'BEGIN {
    split(version, part, ".")
    if (part[1] > 1 || (part[1] == 1 && (part[2] > 3 || (part[2] == 3 && part[3] > 0)))) exit 0
    exit 1
  }'
}

endpoint_image_save() {
  endpoint=$1
  archive=$2
  image=$3
  parse_endpoint "$endpoint"
  case "$ENDPOINT_TOOL" in
    nerdctl) endpoint_exec "$endpoint" save -o "$archive" "$image" ;;
    apple) endpoint_exec "$endpoint" image save --output "$archive" "$image" ;;
    *) endpoint_exec "$endpoint" image save -o "$archive" "$image" ;;
  esac
}

endpoint_image_load() {
  endpoint=$1
  archive=$2
  parse_endpoint "$endpoint"
  case "$ENDPOINT_TOOL" in
    nerdctl) endpoint_exec "$endpoint" load -i "$archive" ;;
    apple)
      if ! apple_image_load_is_safe; then
        printf 'ctx: Apple Container image import requires container newer than 1.3.0; update it before loading archives\n' >&2
        exit 1
      fi
      endpoint_exec "$endpoint" image load --input "$archive"
      ;;
    *) endpoint_exec "$endpoint" image load -i "$archive" ;;
  esac
}

endpoint_volume_export() {
  endpoint=$1
  volume=$2
  endpoint_exec "$endpoint" run --rm -v "$volume:/volume:ro" "$VOLUME_IMAGE" tar -C /volume -cf - .
}

endpoint_volume_import() {
  endpoint=$1
  volume=$2
  endpoint_exec "$endpoint" run --rm -i -v "$volume:/volume" "$VOLUME_IMAGE" tar -C /volume -xf -
}

build() {
  engine=docker
  case "${1:-}" in
    docker|podman|nerdctl) engine=$1; shift ;;
  esac
  cache_ref=
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --cache-ref)
        [ "$#" -ge 2 ] || { printf 'ctx: --cache-ref needs a registry reference\n' >&2; exit 2; }
        cache_ref=$2
        shift 2
        ;;
      --cache-ref=*)
        cache_ref=${1#--cache-ref=}
        shift
        ;;
      --)
        shift
        break
        ;;
      *) break ;;
    esac
  done
  [ -n "$cache_ref" ] || { printf 'ctx: build requires --cache-ref <registry-ref>\n' >&2; exit 2; }
  [ "$#" -gt 0 ] || { printf 'ctx: build needs build arguments\n' >&2; exit 2; }
  case "$engine" in
    docker)
      docker_exec buildx build \
        --cache-from "type=registry,ref=$cache_ref" \
        --cache-to "type=registry,ref=$cache_ref,mode=max" \
        "$@"
      ;;
    podman)
      podman_exec build --layers --cache-from "$cache_ref" --cache-to "$cache_ref" "$@"
      ;;
    nerdctl)
      nerdctl_exec build \
        --cache-from "type=registry,ref=$cache_ref" \
        --cache-to "type=registry,ref=$cache_ref,mode=max" \
        "$@"
      ;;
  esac
}

image_sync() {
  mode=registry
  if [ "${1:-}" = --tar ]; then mode=tar; shift; fi
  [ "$#" -ge 3 ] || { printf 'ctx: image sync needs source context, target context, and image names\n' >&2; exit 2; }
  source_context=$1
  target_context=$2
  shift 2
  if [ "$mode" = tar ]; then
    archive=$(mktemp "${TMPDIR:-/tmp}/ctx-image.XXXXXX")
    trap 'rm -f "$archive"' EXIT HUP INT TERM
    docker_context_exec "$source_context" image save -o "$archive" "$@"
    docker_context_exec "$target_context" image load -i "$archive"
    rm -f "$archive"
    trap - EXIT HUP INT TERM
  else
    for image in "$@"; do
      docker_context_exec "$source_context" image push "$image"
      docker_context_exec "$target_context" image pull "$image"
    done
  fi
}

image_copy() {
  [ "$#" -ge 3 ] || { printf 'ctx: image copy needs source endpoint, target endpoint, and image names\n' >&2; exit 2; }
  source_endpoint=$1
  target_endpoint=$2
  shift 2
  for image in "$@"; do
    archive=$(mktemp "${TMPDIR:-/tmp}/ctx-image.XXXXXX")
    trap 'rm -f "$archive"' EXIT HUP INT TERM
    endpoint_image_save "$source_endpoint" "$archive" "$image"
    endpoint_image_load "$target_endpoint" "$archive"
    rm -f "$archive"
    trap - EXIT HUP INT TERM
  done
}

volume_export() {
  [ "$#" -eq 2 ] || { printf 'ctx: volume export needs a source context and volume name\n' >&2; exit 2; }
  printf 'ctx: export is only crash-consistent; stop or quiesce databases first\n' >&2
  docker_context_exec "$1" run --rm -v "$2:/volume:ro" "$VOLUME_IMAGE" tar -C /volume -cf - .
}

volume_import() {
  [ "$#" -eq 2 ] || { printf 'ctx: volume import needs a target context and new volume name\n' >&2; exit 2; }
  target_context=$1
  volume=$2
  if docker_context_exec "$target_context" volume inspect "$volume" >/dev/null 2>&1; then
    printf 'ctx: target volume %s already exists; refusing to merge data\n' "$volume" >&2
    exit 1
  fi
  docker_context_exec "$target_context" volume create "$volume"
  docker_context_exec "$target_context" run --rm -i -v "$volume:/volume" "$VOLUME_IMAGE" tar -C /volume -xf -
}

volume_copy() {
  [ "$#" -ge 3 ] && [ "$#" -le 4 ] || { printf 'ctx: volume copy needs source endpoint, target endpoint, source volume, and optional target volume\n' >&2; exit 2; }
  source_endpoint=$1
  target_endpoint=$2
  source_volume=$3
  target_volume=${4:-$source_volume}
  printf 'ctx: copy is only crash-consistent; stop or quiesce databases first\n' >&2
  if endpoint_exec "$target_endpoint" volume inspect "$target_volume" >/dev/null 2>&1; then
    printf 'ctx: target volume %s already exists; refusing to merge data\n' "$target_volume" >&2
    exit 1
  fi
  archive=$(mktemp "${TMPDIR:-/tmp}/ctx-volume.XXXXXX")
  trap 'rm -f "$archive"' EXIT HUP INT TERM
  endpoint_volume_export "$source_endpoint" "$source_volume" > "$archive"
  endpoint_exec "$target_endpoint" volume create "$target_volume"
  endpoint_volume_import "$target_endpoint" "$target_volume" < "$archive"
  rm -f "$archive"
  trap - EXIT HUP INT TERM
}

write_choice() {
  key="$1"
  name="$2"
  file=.ctx
  tmp=$(mktemp)
  if [ -f "$file" ]; then
    awk -v key="$key" -v value="$name" '
      $0 ~ "^[[:space:]]*" key "[[:space:]]*=" {
        if (!written) { print key " = \"" value "\""; written=1 }
        next
      }
      { print }
      END { if (!written) print key " = \"" value "\"" }
    ' "$file" > "$tmp"
  else
    printf '%s = "%s"\n' "$key" "$name" > "$tmp"
  fi
  mv "$tmp" "$file"
  if git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    exclude=$(git rev-parse --path-format=absolute --git-path info/exclude)
    mkdir -p "$(dirname "$exclude")"
    if ! grep -Fxq .ctx "$exclude" 2>/dev/null; then printf '\n.ctx\n' >> "$exclude"; fi
  fi
}

write_default() {
  key="${1}_default"
  name="$2"
  mkdir -p "$CTX_HOME"
  [ -f "$CONFIG" ] || printf '# ctx fallbacks and project map\n' > "$CONFIG"
  tmp=$(mktemp)
  awk -v key="$key" -v value="$name" '
    BEGIN { print key " = \"" value "\"" }
    /^\[/ { in_section=1 }
    !in_section && $0 ~ "^[[:space:]]*" key "[[:space:]]*=" { next }
    { print }
  ' "$CONFIG" > "$tmp"
  mv "$tmp" "$CONFIG"
}

adapter_key_allowed() {
  candidate_key="$1"
  [ "$candidate_key" = "$ADAPTER_SELECTOR_KEY" ] && return 0
  case ",$ADAPTER_EXTRA_KEYS," in *",$candidate_key,"*) return 0 ;; *) return 1 ;; esac
}

adapter_configure_selection() {
  adapter_name="$1"
  requested_selection="$2"
  shift 2
  adapter_load "$adapter_name"
  adapter_assert_trusted_loaded
  if adapter_has_capability configure; then
    configured_values=$(mktemp)
    ADAPTER_REQUESTED_COMMAND=$adapter_name adapter_invoke "$adapter_name" configure "$requested_selection" "$@" > "$configured_values"
    primary_written=0
    tab=$(printf '\t')
    while IFS="$tab" read -r configured_key configured_value; do
      [ -n "$configured_key" ] || continue
      adapter_key_allowed "$configured_key" || { rm -f "$configured_values"; printf 'ctx: adapter %s returned undeclared key %s\n' "$adapter_name" "$configured_key" >&2; return 1; }
      [ -n "$configured_value" ] || { rm -f "$configured_values"; printf 'ctx: adapter %s returned an empty value for %s\n' "$adapter_name" "$configured_key" >&2; return 1; }
      write_choice "$configured_key" "$configured_value"
      if [ "$configured_key" = "$ADAPTER_SELECTOR_KEY" ]; then primary_written=1; fi
    done < "$configured_values"
    rm -f "$configured_values"
    [ "$primary_written" -eq 1 ] || { printf 'ctx: adapter %s did not return selector key %s\n' "$adapter_name" "$ADAPTER_SELECTOR_KEY" >&2; return 1; }
  else
    adapter_invoke "$adapter_name" validate "$requested_selection"
    write_choice "$ADAPTER_SELECTOR_KEY" "$requested_selection"
  fi
}

clear_choice() {
  selector="${1:-}"
  [ -f .ctx ] || return 0
  if [ -z "$selector" ]; then
    rm .ctx
    return
  fi
  case "$selector" in
    docker|podman|nerdctl) keys="$selector" ;;
    browser) keys='browser' ;;
    profile) keys='profile' ;;
    *)
      if adapter_exists "$selector"; then
        adapter_load "$selector"
        keys=$(adapter_config_keys | awk 'BEGIN { ORS="" } { if (NR > 1) printf "|"; printf "%s", $0 }')
      elif valid_adapter_name "$selector"; then keys="$selector"
      else printf 'ctx: cannot clear %s\n' "$selector" >&2; exit 2
      fi
      ;;
  esac
  tmp=$(mktemp)
  awk -v keys="$keys" '$0 !~ "^[[:space:]]*(" keys ")[[:space:]]*="' .ctx > "$tmp"
  if grep -Eq '^[[:space:]]*[a-z][a-z0-9_]*[[:space:]]*=' "$tmp"; then
    mv "$tmp" .ctx
  else
    rm .ctx "$tmp"
  fi
}

set_selector() {
  selector="$1"
  name="$2"
  shift 2
  case "$selector" in
    docker|podman|nerdctl)
      if ! validate_selector "$selector" "$name"; then
        printf 'ctx: unknown %s %s\n' "$selector" "$name" >&2
        exit 1
      fi
      if [ "${1:-}" = --global ] && [ "$#" -eq 1 ]; then
        write_default "$selector" "$name"
        printf '%s fallback: %s\n' "$selector" "$name"
      elif [ "$#" -eq 0 ]; then
        write_choice "$selector" "$name"
        printf '%s: %s in %s/.ctx\n' "$selector" "$name" "$PWD"
      else
        usage >&2; exit 2
      fi
      ;;
    browser)
      [ "$#" -eq 0 ] || { usage >&2; exit 2; }
      if ! validate_selector browser "$name"; then
        printf 'ctx: browser must be firefox:<profile>, chrome:<profile>, or chromium:<profile> and its launcher must be available\n' >&2
        exit 1
      fi
      write_choice browser "$name"
      printf 'browser: %s in %s/.ctx\n' "$name" "$PWD"
      ;;
    *)
      external_selection=$name
      adapter_configure_selection "$selector" "$external_selection" "$@"
      printf '%s: %s in %s/.ctx\n' "$selector" "$external_selection" "$PWD"
      ;;
  esac
}

profile_command() {
  action="${1:-}"
  case "$action" in
    ls|list) list_profiles ;;
    show)
      name="${2:-}"
      [ -n "$name" ] && [ "$#" -eq 2 ] || { printf 'ctx: profile show needs a profile name\n' >&2; exit 2; }
      if ! profile_exists "$name"; then printf 'ctx: unknown profile %s\n' "$name" >&2; exit 1; fi
      show_profile "$name"
      ;;
    use)
      name="${2:-}"
      [ -n "$name" ] && [ "$#" -eq 2 ] || { printf 'ctx: profile use needs a profile name\n' >&2; exit 2; }
      if ! valid_profile_name "$name"; then printf 'ctx: invalid profile name %s\n' "$name" >&2; exit 2; fi
      if ! profile_exists "$name"; then
        printf 'ctx: unknown profile %s\n' "$name" >&2
        exit 1
      fi
      write_choice profile "$name"
      printf 'profile: %s in %s/.ctx\n' "$name" "$PWD"
      ;;
    set)
      name="${2:-}"
      key="${3:-}"
      value="${4:-}"
      [ "$#" -eq 4 ] && [ -n "$value" ] || { printf 'ctx: profile set needs name, key, and value\n' >&2; exit 2; }
      if ! valid_profile_name "$name"; then printf 'ctx: invalid profile name %s\n' "$name" >&2; exit 2; fi
      if ! valid_profile_key "$key"; then printf 'ctx: unsupported profile key %s\n' "$key" >&2; exit 2; fi
      case "$value" in *'"'*) printf 'ctx: profile values cannot contain double quotes\n' >&2; exit 2 ;; esac
      write_profile_choice "$name" "$key" "$value"
      printf 'profile %s: %s = %s\n' "$name" "$key" "$value"
      ;;
    unset)
      name="${2:-}"
      key="${3:-}"
      [ "$#" -eq 3 ] || { printf 'ctx: profile unset needs name and key\n' >&2; exit 2; }
      if ! valid_profile_name "$name"; then printf 'ctx: invalid profile name %s\n' "$name" >&2; exit 2; fi
      if ! valid_profile_key "$key" && ! valid_adapter_name "$key"; then printf 'ctx: unsupported profile key %s\n' "$key" >&2; exit 2; fi
      unset_profile_choice "$name" "$key"
      printf 'profile %s: cleared %s\n' "$name" "$key"
      ;;
    env)
      name="${2:-}"
      key="${3:-}"
      value="${4:-}"
      [ "$#" -eq 4 ] || { printf 'ctx: profile env needs name, variable, and value\n' >&2; exit 2; }
      if ! valid_profile_name "$name"; then printf 'ctx: invalid profile name %s\n' "$name" >&2; exit 2; fi
      if ! valid_env_key "$key"; then printf 'ctx: invalid environment variable %s\n' "$key" >&2; exit 2; fi
      case "$value" in *'"'*|*'	'*) printf 'ctx: environment values cannot contain double quotes or tabs\n' >&2; exit 2 ;; esac
      write_profile_env "$name" "$key" "$value"
      printf 'profile %s environment: %s set\n' "$name" "$key"
      ;;
    env-unset)
      name="${2:-}"
      key="${3:-}"
      [ "$#" -eq 3 ] || { printf 'ctx: profile env-unset needs name and variable\n' >&2; exit 2; }
      if ! valid_profile_name "$name"; then printf 'ctx: invalid profile name %s\n' "$name" >&2; exit 2; fi
      if ! valid_env_key "$key"; then printf 'ctx: invalid environment variable %s\n' "$key" >&2; exit 2; fi
      unset_profile_env "$name" "$key"
      printf 'profile %s environment: cleared %s\n' "$name" "$key"
      ;;
    clear)
      [ "$#" -eq 1 ] || { printf 'ctx: profile clear takes no name\n' >&2; exit 2; }
      clear_choice profile
      printf 'cleared profile in %s/.ctx\n' "$PWD"
      ;;
    *) printf 'ctx: profile requires ls, show, use, set, unset, env, env-unset, or clear\n' >&2; exit 2 ;;
  esac
}

explain_line() {
  label="$1"
  key="$2"
  resolve_key "$key"
  if [ -n "$RESOLVED" ]; then
    printf '%-16s %s (%s)\n' "$label" "$RESOLVED" "$VIA"
  else
    printf '%-16s <native default>\n' "$label"
  fi
}

explain() {
  explain_line profile profile
  explain_line docker docker
  explain_line podman podman
  explain_line nerdctl nerdctl
  explain_line browser browser
  explain_line shell-path shell_path
  list_adapter_names | while IFS= read -r name; do
    [ -n "$name" ] || continue
    if adapter_load "$name" >/dev/null 2>&1; then
      [ "$ADAPTER_KIND" = selector ] || continue
      resolve_key "$ADAPTER_SELECTOR_KEY"
      selection=$RESOLVED
      selection_via=$VIA
      if adapter_is_trusted_loaded; then state=trusted; else state=untrusted; fi
      if [ -n "$selection" ]; then
        printf '%-16s %s (%s; adapter %s; %s)\n' "$name" "$selection" "$selection_via" "$ADAPTER_EXEC_PATH" "$state"
      else
        printf '%-16s <not selected> (adapter %s; %s)\n' "$name" "$ADAPTER_EXEC_PATH" "$state"
      fi
    else
      printf '%-16s <invalid adapter>\n' "$name"
    fi
  done
}

doctor() {
  failures=0
  checked=0

  resolve_key profile
  if [ -n "$RESOLVED" ]; then
    checked=1
    if profile_exists "$RESOLVED"; then
      printf 'ok   profile %s\n' "$RESOLVED"
    else
      printf 'fail profile %s does not exist in %s\n' "$RESOLVED" "$CONFIG"
      failures=$((failures + 1))
    fi
  fi

  for selector in docker podman nerdctl; do
    resolve_key "$selector"
    if [ -n "$RESOLVED" ]; then
      checked=1
      if validate_selector "$selector" "$RESOLVED"; then
        printf 'ok   %s %s\n' "$selector" "$RESOLVED"
      else
        printf 'fail %s %s is unavailable\n' "$selector" "$RESOLVED"
        failures=$((failures + 1))
      fi
    fi
  done

  if [ -n "${CTX_BROWSER:-}" ]; then browser_choice=$CTX_BROWSER
  else resolve_key browser; browser_choice=$RESOLVED
  fi
  if [ -n "$browser_choice" ]; then
    checked=1
    if validate_browser_choice "$browser_choice"; then
      printf 'ok   browser %s\n' "$browser_choice"
    else
      printf 'fail browser %s is unavailable\n' "$browser_choice"
      failures=$((failures + 1))
    fi
  fi

  adapter_names=$(mktemp)
  list_adapter_names > "$adapter_names"
  while IFS= read -r name; do
    [ -n "$name" ] || continue
    if ! adapter_load "$name" >/dev/null 2>&1; then continue; fi
    [ "$ADAPTER_KIND" = selector ] || continue
    resolve_key "$ADAPTER_SELECTOR_KEY"
    selection=$RESOLVED
    [ -n "$selection" ] || continue
    checked=1
    if adapter_invoke "$name" doctor "$selection" >/dev/null; then
      printf 'ok   adapter %s %s\n' "$name" "$selection"
    else
      printf 'fail adapter %s %s is unavailable\n' "$name" "$selection"
      failures=$((failures + 1))
    fi
  done < "$adapter_names"
  rm -f "$adapter_names"

  if [ "$checked" -eq 0 ]; then printf 'ok   no ctx-managed selections\n'; fi
  [ "$failures" -eq 0 ]
}

case "${1:-}" in
  ''|help|--help|-h) usage ;;
  version|--version|-v) printf 'ctx %s\n' "$VERSION" ;;
  real)
    check_tool "${2:-}"
    find_real "$2"
    ;;
  resolve)
    check_tool "${2:-}"
    resolve "$2"
    printf '%s\n' "$RESOLVED"
    ;;
  status)
    if [ -n "${2:-}" ]; then check_selector "$2"; status_one "$2"
    else
      status_one docker; status_one podman; status_one nerdctl; status_one browser
      list_adapter_names | while IFS= read -r name; do
        [ -n "$name" ] || continue
        if adapter_load "$name" >/dev/null 2>&1 && [ "$ADAPTER_KIND" = selector ]; then status_one "$name"; fi
      done
    fi
    ;;
  ls)
    check_selector "${2:-}"
    case "$2" in
      docker) real=$(find_real docker); "$real" context ls ;;
      podman) real=$(find_real podman); "$real" system connection list ;;
      nerdctl) real=$(find_real nerdctl); "$real" namespace ls ;;
      browser) browser_list ;;
      *) adapter_invoke "$2" list '' ;;
    esac
    ;;
  set)
    check_selector "${2:-}"
    selector=$2
    name="${3:-}"
    [ -n "$name" ] || { usage >&2; exit 2; }
    shift 3
    set_selector "$selector" "$name" "$@"
    ;;
  clear)
    clear_choice "${2:-}"
    printf 'cleared %s/.ctx\n' "$PWD"
    ;;
  profile)
    shift
    profile_command "$@"
    ;;
  adapter)
    shift
    adapter_command "$@"
    ;;
  run)
    shift
    run_tool "$@"
    ;;
  shell)
    shift
    shell_command "$@"
    ;;
  env) show_environment ;;
  open)
    shift
    open_command "$@"
    ;;
  explain) explain ;;
  doctor) doctor ;;
  build)
    shift
    build "$@"
    ;;
  image)
    case "${2:-}" in
      sync) shift 2; image_sync "$@" ;;
      copy) shift 2; image_copy "$@" ;;
      *) usage >&2; exit 2 ;;
    esac
    ;;
  volume)
    case "${2:-}" in
      export) shift 2; volume_export "$@" ;;
      import) shift 2; volume_import "$@" ;;
      copy) shift 2; volume_copy "$@" ;;
      *) usage >&2; exit 2 ;;
    esac
    ;;
  *) usage >&2; exit 2 ;;
esac
